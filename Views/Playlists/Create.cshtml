@model EmptyMvcProject.Models.Playlist

@{
    ViewData["Title"] = "Create Playlist";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-5">
                <h2 class="text-center text-primary fw-bold mb-4">New Playlist</h2>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Name" class="form-control" id="floatingName" placeholder="Playlist Name" />
                        <label asp-for="Name" for="floatingName">Playlist Name</label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Type" class="form-control" id="floatingType" placeholder="Playlist Type" />
                        <label asp-for="Type" for="floatingType">Playlist Type</label>
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold">Create</button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <a asp-action="Index" class="text-decoration-none text-secondary hover-primary">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
