@model IEnumerable<EmptyMvcProject.Models.Playlist>

@{
    ViewData["Title"] = "Playlists";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2 class="text-primary fw-bold mb-0">Playlist Management</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4 fw-bold">
        + Add Playlist
    </a>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Id</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th class="text-center pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                        <td class="ps-4 fw-medium text-secondary">
                            @Html.DisplayFor(modelItem => item.Id)
                        </td>
                        <td class="fw-bold">
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            <span class="badge bg-info text-dark rounded-pill px-3">
                                @Html.DisplayFor(modelItem => item.Type)
                            </span>
                        </td>
                        <td class="text-center pe-4">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-2">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Remove</a>
                        </td>
                    </tr>
            }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            No playlists found. Click "Add Playlist" to create one.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
