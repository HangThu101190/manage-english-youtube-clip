@model IEnumerable<EmptyMvcProject.Models.Playlist>

@{
    ViewData["Title"] = "Playlists";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2 class="text-primary fw-bold mb-0">Playlist Management</h2>
    <!-- Button trigger modal -->
    <button type="button" class="btn btn-primary shadow-sm rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#createPlaylistModal">
        + Add Playlist
    </button>
</div>

<!-- Modal -->
<div class="modal fade" id="createPlaylistModal" tabindex="-1" aria-labelledby="createPlaylistModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header border-bottom-0 pb-0">
        <h1 class="modal-title fs-4 text-primary fw-bold" id="createPlaylistModalLabel">New Playlist</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form asp-action="Create" method="post">
          <div class="modal-body pt-4">
                <div class="form-floating mb-3">
                    <input name="Name" class="form-control" id="floatingName" placeholder="Playlist Name" required />
                    <label for="floatingName">Playlist Name</label>
                </div>

                <div class="form-floating mb-2">
                    <input name="Type" class="form-control" id="floatingType" placeholder="Playlist Type" required />
                    <label for="floatingType">Playlist Type</label>
                </div>
          </div>
          <div class="modal-footer border-top-0 pt-0">
            <button type="button" class="btn btn-outline-secondary rounded-pill fw-bold" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary rounded-pill fw-bold px-4">Create</button>
          </div>
      </form>
    </div>
  </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Id</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th class="text-center pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                        <td class="ps-4 fw-medium text-secondary">
                            @Html.DisplayFor(modelItem => item.Id)
                        </td>
                        <td class="fw-bold">
                            <a asp-controller="Videos" asp-action="Index" asp-route-playlistId="@item.Id" class="text-decoration-none text-dark hover-primary">
                            @Html.DisplayFor(modelItem => item.Name)</a>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark rounded-pill px-3">
                                @Html.DisplayFor(modelItem => item.Type)
                            </span>
                        </td>
                        <td class="text-center pe-4">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-2">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Remove</a>
                        </td>
                    </tr>
            }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            No playlists found. Click "Add Playlist" to create one.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
