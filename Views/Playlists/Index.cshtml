@model IEnumerable<EmptyMvcProject.Models.Playlist>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-end mb-3 mt-4">
    <a asp-action="Create" class="btn btn-outline-danger fw-bold rounded-0 border-2">Add Playlist</a>
</div>

<style>
    .table-red-borders {
        border: 2px solid red;
    }
    .table-red-borders th,
    .table-red-borders td {
        border: 2px solid red;
        color: red;
    }
</style>

<table class="table table-bordered text-center align-middle table-red-borders">
    <thead>
        <tr>
            <th class="fs-4">Id</th>
            <th class="fs-4">Name</th>
            <th class="fs-4">Type</th>
            <th class="fs-4">Action</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td class="fs-5">
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td class="fs-5">
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td class="fs-5">
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger text-decoration-none fw-bold fs-5 me-2">Remove</a> |
                <a asp-action="Edit" asp-route-id="@item.Id" class="text-danger text-decoration-none fw-bold fs-5 ms-2">Edit</a>
            </td>
        </tr>
}
    </tbody>
</table>
