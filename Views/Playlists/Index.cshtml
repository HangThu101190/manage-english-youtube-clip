@model IEnumerable<EmptyMvcProject.Models.Playlist>

@{
    ViewData["Title"] = "Playlists";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h2 class="text-primary fw-semibold mb-0" style="font-size: 1.75rem;">Playlist Management</h2>
    <!-- Button trigger modal -->
    <button type="button" class="btn btn-primary shadow-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createPlaylistModal">
        + Add Playlist
    </button>
</div>

<!-- Modal -->
<div class="modal fade" id="createPlaylistModal" tabindex="-1" aria-labelledby="createPlaylistModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-bottom-0 pb-0 mt-2 px-4">
        <h1 class="modal-title fs-5 text-primary fw-semibold" id="createPlaylistModalLabel">New Playlist</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form asp-action="Create" method="post">
          <div class="modal-body pt-4 px-4">
                <div class="mb-4">
                    <input name="Name" class="form-control form-control-lg fs-6 shadow-none border-secondary-subtle" id="playlistName" placeholder="Playlist Name" required />
                </div>

                <div class="mb-4">
                    <input name="Type" class="form-control form-control-lg fs-6 shadow-none border-secondary-subtle" id="playlistType" placeholder="Playlist Type" required />
                </div>
          </div>
          <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary rounded-pill px-4">Create</button>
          </div>
      </form>
    </div>
  </div>
</div>

<div class="card shadow-sm border-0 rounded-3 mt-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Type</th>
                        <th class="text-center pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                        <td class="fw-semibold ps-4">
                            <a asp-controller="Videos" asp-action="Index" asp-route-playlistId="@item.Id" class="text-decoration-none text-dark hover-primary">
                            @Html.DisplayFor(modelItem => item.Name)</a>
                        </td>
                        <td>
                            <span class="badge bg-info bg-opacity-25 text-info-emphasis rounded-pill px-3 py-2 fw-medium border border-info-subtle">
                                @Html.DisplayFor(modelItem => item.Type)
                            </span>
                        </td>
                        <td class="text-center pe-4">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-2">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Remove</a>
                        </td>
                    </tr>
            }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">
                            No playlists found. Click "Add Playlist" to create one.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
