@model EmptyMvcProject.Models.Video

@{
    ViewData["Title"] = "Delete Video";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-danger text-white rounded-top-3 py-3 border-0">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Deletion</h4>
                </div>
                <div class="card-body p-4 text-center">
                    <h5 class="card-title text-danger fw-bold mb-3">Are you sure you want to delete this video?</h5>
                    <p class="card-text text-muted mb-4">This action cannot be undone.</p>

                    <div class="bg-light rounded p-3 mb-4 text-start">
                        <div class="row mb-2">
                            <div class="col-sm-4 fw-bold text-secondary">Description</div>
                            <div class="col-sm-8 text-dark fs-5 fw-semibold">@Html.DisplayFor(model => model.Description)</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4 fw-bold text-secondary">Uploaded</div>
                            <div class="col-sm-8 text-dark">
                                @if (Model.IsUploaded)
                                {
                                    <span class="badge bg-success rounded-pill">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill">No</span>
                                }
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-3">
                            <a asp-action="Index" asp-route-playlistId="@Model.PlaylistId" class="btn btn-outline-secondary rounded-pill px-4 fw-bold shadow-sm">Cancel</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">Yes, Delete It</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
